#. i18n: /home/martin/xtrackcad/src/gtk3/app/lib/demos/dmtosel.xtr:182
#. i18n: /home/martin/xtrackcad/src/gtk3/app/lib/demos/dmtosel.xtr:225
#: ../../build/app/i18n/custmsg.h:1118
