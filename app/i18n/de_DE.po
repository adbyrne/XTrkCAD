#: ../../build/app/i18n/custmsg.h:5329
msgid "Now drag on a Red arrow to complete the Curve.\n"
msgstr "Jetzt ziehen Sie an der roten Pfeilspitze um den Bogen zu erstellen.\n"

#. i18n: /home/martin/xtrackcad/src/gtk3/app/lib/demos/dmcrvtrk.xtr:118
#. i18n: /home/martin/xtrackcad/src/gtk3/app/lib/demos/dmctlpnl.xtr:112
