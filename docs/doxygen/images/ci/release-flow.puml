' release.yml job flow (dev guide, advanced.md "release.yml").
' Rendered by hand, the SVG is committed next to this file:
'   plantuml -tsvg docs/doxygen/images/ci/release-flow.puml
@startuml release-flow
skinparam defaultFontName sans-serif
skinparam shadowing false
skinparam ArrowColor #555555
skinparam ActivityBorderColor #555555
skinparam ActivityBackgroundColor #F4F6F8
skinparam ActivityDiamondBorderColor #555555
skinparam ActivityDiamondBackgroundColor #FFFFFF

start
:check-inputs
(dispatch: validate inputs and
packages_from_run);
if (packages_from_run set?) then (no)
  fork
    :packages-linux
    (packages-linux.yml);
    :install-tests-linux
    (install-tests.yml);
  fork again
    :packages-windows
    (packages-windows.yml,
    NSIS: tags, include_nsis);
    :install-tests-windows
    (install-tests.yml);
  fork again
    :packages-macos
    (packages-macos.yml,
    DMG: include_dmg);
    :install-tests-macos
    (install-tests.yml);
  end fork
else (yes)
  :install-tests-* only,
  on that run's packages;
endif
note right
  Each platform's install tests wait
  only for its own packages. A platform
  turned off in a dispatch is skipped.
  latest-main doesn't wait for them.
end note
fork
  if (push to main?) then (yes)
    :publish-latest-release
    (needs the packages,
    not the install tests);
    :deploy-pages
    (docs + QA reports);
  endif
fork again
  if (version tag?) then (yes)
    :check-release-tag;
    :github-release (draft)
    needs every package
    AND every install test;
  endif
fork again
  if (dispatch with
  publish_temp_release?) then (yes)
    :publish-temp-release
    (all platforms, fresh build);
  endif
end fork
stop
@enduml
