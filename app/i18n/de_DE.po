#: ../../build/app/i18n/custmsg.h:3669 ../../build/app/i18n/custmsg.h:4965
#: ../../build/app/i18n/custmsg.h:6251
msgid ""
"Holding down the Shift key while you Right-Click will display options for "
"the current command (if any)."
msgstr ""
"Bleibt die Umschalt Taste gedrückt während Sie ein Kommando ausgewählt haben "
"werden (wenn vorhanden) Optionen für dieses Kommando angezeigt."

#. i18n: /home/martin/xtrackcad/src/gtk3/app/help/xtrkcad.tip:89
#. i18n: /home/martin/xtrackcad/src/gtk3/build/app/share/xtrkcad-5.4.0/xtrkcad.tip:89
#. i18n: /home/martin/xtrackcad/src/gtk3/build/install/share/xtrkcad-5.4.0/xtrkcad.tip:89
