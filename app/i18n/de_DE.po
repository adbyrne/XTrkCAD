#: ../../build/app/i18n/custmsg.h:6257
msgid ""
"To refresh the Main window, press Control-L (hold down the 'Ctrl' key and "
"then press the 'l' key)."
msgstr ""
"Um die Darstellung im Hauptfenster zu erneuern, benutzen Sie Strg+L (halten "
"Die die Steuerung Taste gedrückt und tippen Sie den Buchstaben 'l')."

#. i18n: /home/martin/xtrackcad/src/gtk3/app/help/xtrkcad.tip:97
#. i18n: /home/martin/xtrackcad/src/gtk3/build/app/share/xtrkcad-5.4.0/xtrkcad.tip:97
#. i18n: /home/martin/xtrackcad/src/gtk3/build/install/share/xtrkcad-5.4.0/xtrkcad.tip:97
