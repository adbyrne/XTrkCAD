#cmakedefine XTRKCAD_USE_GETTEXT
#cmakedefine XTRKCAD_TESTING
#cmakedefine XTRKCAD_CREATE_SVG 1
#cmakedefine XTRKCAD_GTK3_WLIB

// root path used for GTK resources, used in GTK3 library only
#define XTRKCAD_RESOURCE_PATH "@XTRKCAD_BUILDER_ROOT@/"
#define XTRKCAD_SYMBOLS_PATH "@XTRKCAD_SYMBOLS_ROOT@/"
#define XTRKCAD_ICONS_PATH "@XTRKCAD_ICONS_ROOT@/"

#define XTRKCAD_INSTALL_PREFIX "@CMAKE_INSTALL_PREFIX@"
#define XTRKCAD_SHARE_INSTALL_DIR "@XTRKCAD_SHARE_INSTALL_DIR@"
#define XTRKCAD_PACKAGE "@XTRKCAD_PACKAGE@"
#define XTRKCAD_VERSION "@XTRKCAD_VERSION@"
#define XTRKCAD_VERSION_ID "@XTRKCAD_VERSION_ID@"
#define XTRKCAD_PARAMVERSION (12)
#define XTRKCAD_PARAMVERSIONVERSION "5.2.0"
#define XTRKCAD_MINPARAMVERSION (1)

#cmakedefine01 XTRKCAD_BUILD_FLATPAK

