#. i18n: C:/Users/mf/Documents/XTrackCAD/src/v5_3_0_beta1/app/lib/demos/dmnotes.xtr:14
#: ../../../../build/v_5_3_0_beta1/app/i18n/custmsg.h:867
#, fuzzy
