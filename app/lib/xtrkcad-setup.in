#!/bin/sh

usage() {
	echo "$0 (install|remove|desktop) <install-dir>"
	echo
	echo "install: Sets up file associations and menus for XTrkCad"
	echo "remove: Removes file associations and menus for XTrkCad"
	echo "desktop: Installs short cut on the user's desktop"
	echo
	echo "<install-dir> is the location of XTrkCad's data files"
	echo
	echo "to be run as normal user"
	exit 0
}

echo "`date`: $0 $* as ${USER}"

if [ $# -ne 2 ] ; then
	usage
fi

COMMAND="$1"
export INSTALLDIR="$2"

# XTRKCAD_BIN identifies this build (e.g. xtrkcad-5.4.0) — baked in at
# configure time instead of sniffed at runtime from which .desktop file
# happens to exist, so each installed version manages only its own files.
XTRKCAD_BIN="@XTRKCAD_BIN@"

if [ ! -d ${INSTALLDIR} ] ; then
	echo "$0: $INSTALLDIR: not found"
	exit 1
fi
if [ ! -f ${INSTALLDIR}/applications/xtrkcad.xml ] ; then
	echo "$0: $INSTALLDIR/applications/xtrkcad.xml: not found"
	exit 1
fi
if [ ! -f ${INSTALLDIR}/applications/${XTRKCAD_BIN}.desktop ] ; then
	echo "$0: $INSTALLDIR/applications/${XTRKCAD_BIN}.desktop: not found"
	exit 1
fi
if [ ! -f ${INSTALLDIR}/pixmaps/${XTRKCAD_BIN}.png ] ; then
	echo "$0: $INSTALLDIR/pixmaps/${XTRKCAD_BIN}.png: not found"
	exit 1
fi

ID=`id -u`
if [ $ID -eq 0 ]  ; then
	echo $0: Must not be root
	exit 1
fi

if [ "$COMMAND" = "install" ] ; then
	echo SETUP ICONS
	# Icons are registered under this version's own name (${XTRKCAD_BIN})
	# rather than the shared literal "xtrkcad", so installing/removing one
	# version doesn't clobber another's entry in the system icon theme.
	xdg-icon-resource install --context mimetypes --novendor --size 64 ${INSTALLDIR}/pixmaps/${XTRKCAD_BIN}.png ${XTRKCAD_BIN}
	xdg-icon-resource install --context apps --novendor --size 64 ${INSTALLDIR}/pixmaps/${XTRKCAD_BIN}.png ${XTRKCAD_BIN}
	xdg-icon-resource install --context apps --novendor --size 64 ${INSTALLDIR}/pixmaps/${XTRKCAD_BIN}.png application-x-${XTRKCAD_BIN}

	echo SETUP MIME
	# mimetype for .xtc files is application/x-xtrkcad
	xdg-mime install --novendor ${INSTALLDIR}/applications/xtrkcad.xml
	# default handler for application/x-xtrkcad is whichever version was
	# installed/configured most recently (xdg-mime only supports one
	# default handler per mimetype — this is inherent, not a bug here)
	xdg-mime default ${XTRKCAD_BIN}.desktop application/x-xtrkcad
	echo SETUP DESKTOP
	# add app to system menu
	xdg-desktop-menu install --novendor ${INSTALLDIR}/applications/${XTRKCAD_BIN}.desktop
	# add desktop shortcut
	xdg-desktop-icon install --novendor ${INSTALLDIR}/applications/${XTRKCAD_BIN}.desktop
	chmod 755 ${HOME}/Desktop/${XTRKCAD_BIN}.desktop

elif [ "$COMMAND" = "remove" ] ; then
	echo REMOVE DESKTOP
	xdg-desktop-icon uninstall --novendor ${INSTALLDIR}/applications/${XTRKCAD_BIN}.desktop
	xdg-desktop-menu uninstall ${INSTALLDIR}/applications/${XTRKCAD_BIN}.desktop
	echo REMOVE MIME
	xdg-mime uninstall --novendor ${INSTALLDIR}/applications/xtrkcad.xml
	echo REMOVE ICONS
	xdg-icon-resource uninstall --context apps --novendor --size 64 application-x-${XTRKCAD_BIN}
	xdg-icon-resource uninstall --context apps --novendor --size 64 ${XTRKCAD_BIN}
	xdg-icon-resource uninstall --context mimetypes --novendor --size 64 ${XTRKCAD_BIN}

elif [ "$COMMAND" = "desktop" ] ; then
	echo SETUP DESKTOP
	# set desktop command
	xdg-desktop-menu install --novendor ${INSTALLDIR}/applications/${XTRKCAD_BIN}.desktop
	xdg-desktop-icon install --novendor ${INSTALLDIR}/applications/${XTRKCAD_BIN}.desktop
	chmod 755 ${HOME}/Desktop/${XTRKCAD_BIN}.desktop

else
	usage
fi
