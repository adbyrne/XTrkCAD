<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="3.22" />
  <object class="GtkDialog" id="reportsclearance">
    <property name="can-focus">False</property>
    <property name="border-width">12</property>
    <property name="type-hint">dialog</property>
    <property name="use-header-bar">0</property>
    <property name="title" translatable="yes">Report</property>
    <child type="action">
      <object class="GtkButton" id="id_help">
        <property name="use-underline">True</property>
        <property name="label">_Help</property>
        <property name="visible">True</property>
      </object>
    </child>
    <child type="action">
      <object class="GtkButton" id="refresh">
        <property name="label" translatable="yes">_Refresh</property>
        <property name="use-underline">True</property>
        <property name="visible">True</property>
        <property name="can_focus">True</property>
        <property name="receives_default">True</property>
      </object>
    </child>
    <child type="action">
      <object class="GtkButton" id="print">
        <property name="label" translatable="yes">_Print...</property>
        <property name="use-underline">True</property>
        <property name="visible">True</property>
        <property name="can_focus">True</property>
        <property name="receives_default">True</property>
      </object>
    </child>
    <child type="action">
      <object class="GtkButton" id="printsetup">
        <property name="label" translatable="yes">Page Setup...</property>
        <property name="visible">True</property>
        <property name="can_focus">True</property>
        <property name="receives_default">True</property>
        <property name="sensitive">True</property>
      </object>
    </child>
    <child type="action">
      <object class="GtkButton" id="save">
        <property name="label" translatable="yes">_Save...</property>
        <property name="use-underline">True</property>
        <property name="visible">True</property>
        <property name="can_focus">True</property>
        <property name="receives_default">True</property>
      </object>
    </child>
    <child type="action">
      <object class="GtkButton" id="filter">
        <property name="label" translatable="yes">_Filter...</property>
        <property name="tooltip-text" translatable="yes">Scope this report to selected Layers/Groups</property>
        <property name="use-underline">True</property>
        <property name="visible">True</property>
        <property name="can_focus">True</property>
        <property name="receives_default">True</property>
      </object>
    </child>
    <child type="action">
      <object class="GtkButton" id="id_cancel">
        <property name="use-underline">True</property>
        <property name="can-default">True</property>
        <property name="has-default">True</property>
        <property name="label">_Done</property>
        <property name="visible">True</property>
      </object>
    </child>
    <action-widgets>
      <action-widget response="GTK_RESPONSE_CANCEL" default="true">id_cancel</action-widget>
      <action-widget response="GTK_RESPONSE_HELP">id_help</action-widget>
      <action-widget response="1">print</action-widget>
      <action-widget response="2">printsetup</action-widget>
      <action-widget response="3">save</action-widget>
      <action-widget response="4">refresh</action-widget>
      <action-widget response="5">filter</action-widget>
    </action-widgets>
    <child internal-child="vbox">
      <object class="GtkBox">
        <property name="can-focus">False</property>
        <property name="orientation">vertical</property>
        <property name="spacing">6</property>

        <child>
          <object class="GtkLabel" id="summary">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="label" translatable="yes">Summary</property>
            <property name="xalign">0</property>
            <property name="margin-bottom">6</property>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
            <property name="position">0</property>
          </packing>
        </child>
        <child>
          <object class="GtkBox">
            <property name="visible">True</property>
            <property name="hexpand">False</property>
            <property name="spacing">6</property>
            <property name="margin-bottom">6</property>
            <child>
              <object class="GtkLabel">
                <property name="visible">True</property>
                <property name="label" translatable="yes">_Clearance</property>
                <property name="use_underline">True</property>
                <property name="mnemonic-widget">clearance</property>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="position">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkComboBox" id="clearance">
                <property name="model">clearancelist</property>
                <property name="visible">True</property>
                <property name="can_focus">False</property>
                <property name="tooltip-text" translatable="yes">Distance between track centres at which cars on two tracks clear each other (13 ft is US practice). Tracks closer than this are listed.</property>
                <child>
                  <object class="GtkCellRendererText" id="clearancetextfield">
                    <property name="width-chars">16</property>
                  </object>
                  <attributes>
                    <attribute name="text">3</attribute>
                  </attributes>
                </child>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="position">1</property>
              </packing>
            </child>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
            <property name="position">1</property>
          </packing>
        </child>
        <child>
          <object class="GtkScrolledWindow" id="list">
            <property name="visible">True</property>
            <property name="can-focus">True</property>
            <property name="hexpand">True</property>
            <property name="vexpand">True</property>
            <property name="min-content-height">300</property>
            <property name="min-content-width">700</property>
            <property name="shadow-type">in</property>
            <child>
              <object class="GtkTreeView" id="treeview">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="enable-grid-lines">vertical</property>
                <property name="model">liststore</property>
                <child>
                  <object class="GtkTreeViewColumn" id="listplace">
                    <property name="resizable">True</property>
                    <property name="title" translatable="yes">Place</property>
                    <child>
                      <object class="GtkCellRendererText" />
                      <attributes>
                        <attribute name="text">3</attribute>
                      </attributes>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkTreeViewColumn" id="listchange">
                    <property name="resizable">True</property>
                    <property name="title" translatable="yes">Change</property>
                    <child>
                      <object class="GtkCellRendererText" />
                      <attributes>
                        <attribute name="text">4</attribute>
                      </attributes>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkTreeViewColumn" id="listtracka">
                    <property name="resizable">True</property>
                    <property name="title" translatable="yes">Track A</property>
                    <child>
                      <object class="GtkCellRendererText" />
                      <attributes>
                        <attribute name="text">5</attribute>
                      </attributes>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkTreeViewColumn" id="listlayera">
                    <property name="resizable">True</property>
                    <property name="title" translatable="yes">Layer #</property>
                    <child>
                      <object class="GtkCellRendererText" />
                      <attributes>
                        <attribute name="text">6</attribute>
                      </attributes>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkTreeViewColumn" id="listlayernamea">
                    <property name="resizable">True</property>
                    <property name="title" translatable="yes">Layer Name</property>
                    <child>
                      <object class="GtkCellRendererText" />
                      <attributes>
                        <attribute name="text">7</attribute>
                      </attributes>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkTreeViewColumn" id="listtrackb">
                    <property name="resizable">True</property>
                    <property name="title" translatable="yes">Track B</property>
                    <child>
                      <object class="GtkCellRendererText" />
                      <attributes>
                        <attribute name="text">8</attribute>
                      </attributes>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkTreeViewColumn" id="listlayerb">
                    <property name="resizable">True</property>
                    <property name="title" translatable="yes">Layer #</property>
                    <child>
                      <object class="GtkCellRendererText" />
                      <attributes>
                        <attribute name="text">9</attribute>
                      </attributes>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkTreeViewColumn" id="listlayernameb">
                    <property name="resizable">True</property>
                    <property name="title" translatable="yes">Layer Name</property>
                    <child>
                      <object class="GtkCellRendererText" />
                      <attributes>
                        <attribute name="text">10</attribute>
                      </attributes>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkTreeViewColumn" id="listspacing">
                    <property name="resizable">True</property>
                    <property name="title" translatable="yes">Spacing (in)</property>
                    <child>
                      <object class="GtkCellRendererText" />
                      <attributes>
                        <attribute name="text">11</attribute>
                      </attributes>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkTreeViewColumn" id="listlength">
                    <property name="resizable">True</property>
                    <property name="title" translatable="yes">Length (in)</property>
                    <child>
                      <object class="GtkCellRendererText" />
                      <attributes>
                        <attribute name="text">12</attribute>
                      </attributes>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
          <packing>
            <property name="expand">True</property>
            <property name="fill">True</property>
            <property name="position">2</property>
          </packing>
        </child>
      </object>
    </child>
  </object>
  <object class="GtkListStore" id="clearancelist">
    <columns>
      <column type="gboolean" />
      <column type="gpointer" />
      <column type="gpointer" />
      <column type="gchararray" />
    </columns>
  </object>
  <object class="GtkListStore" id="liststore">
    <columns>
      <!-- column-name error_color -->
      <column type="gboolean" />
      <!-- column-name userdata -->
      <column type="gpointer" />
      <!-- column-name bitmap -->
      <column type="GdkPixbuf" />
      <!-- column-name place -->
      <column type="gchararray" />
      <!-- column-name change -->
      <column type="gchararray" />
      <!-- column-name tracka -->
      <column type="gchararray" />
      <!-- column-name layera -->
      <column type="gchararray" />
      <!-- column-name layernamea -->
      <column type="gchararray" />
      <!-- column-name trackb -->
      <column type="gchararray" />
      <!-- column-name layerb -->
      <column type="gchararray" />
      <!-- column-name layernameb -->
      <column type="gchararray" />
      <!-- column-name spacing -->
      <column type="gchararray" />
      <!-- column-name length -->
      <column type="gchararray" />
    </columns>
  </object>
</interface>
