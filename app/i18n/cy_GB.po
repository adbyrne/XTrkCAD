#. i18n: C:/Users/mf/Documents/XTrackCAD/src/v5_3_0_beta1/app/lib/demos/dmctlpnl.xtr:500
#: ../../../../build/v_5_3_0_beta1/app/i18n/custmsg.h:331
msgid "Second step: add LEDs for the turnout position indicators.\n"
