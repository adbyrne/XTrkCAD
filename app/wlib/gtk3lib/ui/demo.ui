<?xml version="1.0" encoding="UTF-8"?>
<interface>
    <requires lib="gtk" version="3.22" />
    <object class="GtkDialog" id="demo">
        <property name="can-focus">False</property>
        <property name="border-width">12</property>
        <property name="type-hint">dialog</property>
        <property name="use-header-bar">0</property>
        <property name="resizable">False</property>
        <child type="action">
            <object class="GtkButton" id="id_cancel">
                <property name="use-underline">True</property>
                <property name="label">_Finish</property>
                <property name="visible">True</property>
            </object>
        </child>
        <action-widgets>
            <action-widget response="GTK_RESPONSE_CANCEL">id_cancel</action-widget>
        </action-widgets>
        <child internal-child="vbox">
            <object class="GtkBox">
                <property name="can-focus">False</property>
                <property name="orientation">vertical</property>
                <property name="spacing">18</property>
                <child internal-child="action_area">

                </child>
                <child>
                    <object class="GtkBox">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="margin-bottom">12</property>
                        <property name="orientation">vertical</property>
                        <property name="spacing">12</property>
                        <child>
                            <object class="GtkScrolledWindow" id="demo-text.scrollwindow">
                                <property name="width-request">450</property>
                                <property name="height-request">200</property>
                                <property name="visible">True</property>
                                <property name="can-focus">True</property>
                                <property name="hexpand">True</property>
                                <property name="vexpand">True</property>
                                <property name="shadow-type">in</property>
                                <property name="min-content-width">200</property>
                                <property name="min-content-height">150</property>
                                <child>
                                    <object class="GtkTextView" id="demo-text">
                                        <property name="visible">True</property>
                                        <property name="can-focus">True</property>
                                        <property name="editable">False</property>
                                        <property name="wrap-mode">word</property>
                                        <property name="cursor-visible">False</property>
                                        <property name="accepts-tab">False</property>
                                        <property name="monospace">True</property>
                                    </object>
                                </child>
                            </object>
                            <packing>
                                <property name="expand">False</property>
                                <property name="fill">True</property>
                                <property name="position">0</property>
                            </packing>
                        </child>
                        <child>
                            <object class="GtkBox">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="spacing">6</property>
                                <child>
                                    <object class="GtkToggleButton" id="id_ok">
                                        <property name="label">_Auto Play</property>
                                        <property name="visible">True</property>
                                        <property name="can-focus">True</property>
                                        <property name="receives-default">True</property>
                                        <property name="use-underline">True</property>
                                        <property name="image-position">right</property>
                                    </object>
                                    <packing>
                                        <property name="expand">False</property>
                                        <property name="fill">False</property>
                                        <property name="position">0</property>
                                    </packing>
                                </child>
                                <child>
                                    <object class="GtkBox">
                                        <property name="visible">True</property>
                                        <property name="can-focus">False</property>
                                        <property name="margin-start">12</property>
                                        <property name="spacing">6</property>
                                        <child>
                                            <object class="GtkLabel">
                                                <property name="visible">True</property>
                                                <property name="can-focus">False</property>
                                                <property name="label" translatable="yes">S_peed</property>
                                                <property name="use-underline">True</property>
                                                <property name="mnemonic-widget">demo-speed</property>
                                            </object>
                                            <packing>
                                                <property name="expand">False</property>
                                                <property name="fill">True</property>
                                                <property name="position">1</property>
                                            </packing>
                                        </child>
                                        <child>
                                            <object class="GtkComboBox" id="demo-speed">
                                                <property name="visible">True</property>
                                                <property name="can-focus">False</property>
                                                <property name="model">speedoptions</property>
                                            </object>
                                            <packing>
                                                <property name="expand">False</property>
                                                <property name="fill">True</property>
                                                <property name="position">2</property>
                                            </packing>
                                        </child>
                                    </object>
                                    <packing>
                                        <property name="expand">True</property>
                                        <property name="fill">True</property>
                                        <property name="position">1</property>
                                    </packing>
                                </child>
                                <child>
                                    <object class="GtkToggleButton" id="demo_next">
                                        <property name="label">_Next Demo</property>
                                        <property name="visible">True</property>
                                        <property name="can-focus">True</property>
                                        <property name="receives-default">True</property>
                                        <property name="use-underline">True</property>
                                        <property name="image-position">right</property>
                                    </object>
                                    <packing>
                                        <property name="expand">False</property>
                                        <property name="fill">False</property>
                                        <property name="position">2</property>
                                    </packing>
                                </child>
                            </object>
                            <packing>
                                <property name="expand">True</property>
                                <property name="fill">True</property>
                                <property name="position">1</property>
                            </packing>
                        </child>
                    </object>
                    <packing>
                        <property name="expand">False</property>
                        <property name="fill">True</property>
                        <property name="position">1</property>
                    </packing>
                </child>
            </object>
        </child>
    </object>
    <object class="GtkSizeGroup">
        <widgets>
            <widget name="id_cancel" />
            <widget name="id_ok" />
            <widget name="demo_next" />
        </widgets>
    </object>
    <object class="GtkListStore" id="speedoptions">
        <columns>
            <column type="gpointer" />
            <column type="GdkPixbuf" />  
            <column type="gchararray" />         
        </columns>
    </object>
</interface>
