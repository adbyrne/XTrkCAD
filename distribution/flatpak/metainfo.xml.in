<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@FLATPAK_DOMAIN@.@FLATPAK_BASE_NAME@</id>
  <name>XTrackCAD@FLATPAK_SUFFIX_NAME@</name>
  <summary>Design model railroad layouts</summary>
  <description>
    <p>XTrackCAD is a CAD (computer-aided design) program for designing model railroad layouts.</p>
    <p><em>Flatpak not officially supported, yet ;-) ; search for "flatpak" from the faq/home wiki</em></p>
  </description>
  <releases>
    <release version="@FLATPAK_VERSION@" date="@XTRKCAD_BUILD_DATE@"/>
  </releases>
  <content_rating type="oars-1.1" />
  <launchable type="desktop-id">@FLATPAK_DOMAIN@.@FLATPAK_BASE_NAME@.desktop</launchable>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0</project_license>
  <url type="bugtracker">https://sourceforge.net/p/xtrkcad-fork/bugs/</url>
  <url type="homepage">https://sourceforge.net/p/xtrkcad-fork/</url>
  <url type="contact">https://groups.io/g/xtrackcad</url>
  <url type="faq">https://sourceforge.net/p/xtrkcad-fork/wiki/Home/</url>
  <url type="contribute">https://sourceforge.net/p/xtrkcad-fork/wiki/Contribute/</url>
  <url type="vcs-browser">https://sourceforge.net/p/xtrkcad-fork/xtrkcad/ci/default/tree/</url>
  <screenshots>
    <screenshot type="default">
      <image>https://cytranet-dal.dl.sourceforge.net/project/xtrkcad-fork/Images/wiki/screenshots/port_dinllean_screenshot.png?viasf=1</image>
      <caption>Example port_dinllean.xtc</caption>
    </screenshot>
  </screenshots>
  <developer id="@FLATPAK_DOMAIN@.@FLATPAK_BASE_NAME@">
    <name>xtrkcad developers</name>
  </developer>
</component>
