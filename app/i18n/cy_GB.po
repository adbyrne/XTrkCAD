#. i18n: C:/Users/mf/Documents/XTrackCAD/src/v5_3_0_beta1/app/lib/demos/dmhelix.xtr:52
#: ../../../../build/v_5_3_0_beta1/app/i18n/custmsg.h:633
#, fuzzy
