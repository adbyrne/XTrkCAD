#: ../../build/app/i18n/custmsg.h:2729 ../../build/app/i18n/custmsg.h:4025
#: ../../build/app/i18n/custmsg.h:5311
msgid "There are several ways to create a Curved track.\n"
msgstr "Es gibt mehrere Möglichkeiten, ein gebogenes Gleis zu erstellen.\n"

#: ../../build/app/i18n/custmsg.h:303 ../../build/app/i18n/custmsg.h:1444
#: ../../build/app/i18n/custmsg.h:2730 ../../build/app/i18n/custmsg.h:4026
#: ../../build/app/i18n/custmsg.h:5312
msgid ""
"You can choose which to use by clicking on the small button to the left of "
"<Curve> command button if the current Curve command is not the one you "
"want.\n"
msgstr ""
"Sie können zwischen diesen wählen, in dem Sie auf die kleine Schaltfläche "
"neben der <Bogen> Schaltfläche drücken.\n"

#: ../../build/app/i18n/custmsg.h:304 ../../build/app/i18n/custmsg.h:1445
#: ../../build/app/i18n/custmsg.h:2731 ../../build/app/i18n/custmsg.h:4027
#: ../../build/app/i18n/custmsg.h:5313
msgid ""
"The first is by clicking on the first End-Point and dragging in the "
"direction of the Curve.\n"
msgstr ""
"In der ersten Möglichkeit wird dieser durch Auswahl des ersten Endpunktes "
"und Ziehen in die Richtung des Bogen erstellt.\n"

#. i18n: /home/martin/xtrackcad/src/gtk3/app/lib/demos/dmcrvtrk.xtr:20
#. i18n: /home/martin/xtrackcad/src/gtk3/build/app/share/xtrkcad-5.4.0/demos/dmcrvtrk.xtr:20
#. i18n: /home/martin/xtrackcad/src/gtk3/build/install/share/xtrkcad-5.4.0/demos/dmcrvtrk.xtr:20
#. i18n: /home/martin/xtrackcad/src/gtk3/build/regression-install/share/xtrkcad-5.4.0.b97b8ced2f12/demos/dmcrvtrk.xtr:20
#. i18n: /home/martin/xtrackcad/src/gtk3/build/regression-install/share/xtrkcad-5.4.0/demos/dmcrvtrk.xtr:20
#: ../../build/app/i18n/custmsg.h:306 ../../build/app/i18n/custmsg.h:1447
#: ../../build/app/i18n/custmsg.h:2733 ../../build/app/i18n/custmsg.h:4029
#: ../../build/app/i18n/custmsg.h:5315
msgid ""
"You will see a straight track with a double ended Red arrow at the end.\n"
msgstr ""
"Sie sehen ein gerades Gleis mit einem roten Pfeil mit zwei Spitzen am Ende.\n"

#: ../../build/app/i18n/custmsg.h:307 ../../build/app/i18n/custmsg.h:1448
#: ../../build/app/i18n/custmsg.h:2734 ../../build/app/i18n/custmsg.h:4030
#: ../../build/app/i18n/custmsg.h:5316
msgid "Click and drag on one of the Red arrows to complete the Curve.\n"
msgstr ""
"Klicken und ziehen Sie eine der roten Spitzen um den Bogen zu "
"vervollständigen.\n"

#. i18n: /home/martin/xtrackcad/src/gtk3/app/lib/demos/dmcrvtrk.xtr:39
#. i18n: /home/martin/xtrackcad/src/gtk3/build/app/share/xtrkcad-5.4.0/demos/dmcrvtrk.xtr:39
#. i18n: /home/martin/xtrackcad/src/gtk3/build/install/share/xtrkcad-5.4.0/demos/dmcrvtrk.xtr:39
#. i18n: /home/martin/xtrackcad/src/gtk3/build/regression-install/share/xtrkcad-5.4.0.b97b8ced2f12/demos/dmcrvtrk.xtr:39
#. i18n: /home/martin/xtrackcad/src/gtk3/build/regression-install/share/xtrkcad-5.4.0/demos/dmcrvtrk.xtr:39
#: ../../build/app/i18n/custmsg.h:309 ../../build/app/i18n/custmsg.h:1450
#: ../../build/app/i18n/custmsg.h:2736 ../../build/app/i18n/custmsg.h:4032
#: ../../build/app/i18n/custmsg.h:5318
msgid ""
"The next method is to click at one End-Point and drag to the center of the "
"Curve.\n"
msgstr ""
"Die nächste Methode ist das Klicken auf einen Endpunkt und das Ziehen zum "
"Mittelpunkt der Kurve.\n"

#. i18n: /home/martin/xtrackcad/src/gtk3/app/lib/demos/dmcrvtrk.xtr:50
#. i18n: /home/martin/xtrackcad/src/gtk3/build/app/share/xtrkcad-5.4.0/demos/dmcrvtrk.xtr:50
#. i18n: /home/martin/xtrackcad/src/gtk3/build/install/share/xtrkcad-5.4.0/demos/dmcrvtrk.xtr:50
#. i18n: /home/martin/xtrackcad/src/gtk3/build/regression-install/share/xtrkcad-5.4.0.b97b8ced2f12/demos/dmcrvtrk.xtr:50
#. i18n: /home/martin/xtrackcad/src/gtk3/build/regression-install/share/xtrkcad-5.4.0/demos/dmcrvtrk.xtr:50
#: ../../build/app/i18n/custmsg.h:311 ../../build/app/i18n/custmsg.h:1452
#: ../../build/app/i18n/custmsg.h:2738 ../../build/app/i18n/custmsg.h:4034
#: ../../build/app/i18n/custmsg.h:5320
msgid ""
"Now you will see the double ended Red arrow connected to the center of the "
"Curve marked by a small circle.\n"
msgstr ""
"Wie vorher sehen Sie den roten Pfeil mit zwei Spitzen, der mit dem "
"Mittelpunkt des Bogen verbunden ist. Dieser ist mit einem kleinen Kreis "
"markiert.\n"

#: ../../build/app/i18n/custmsg.h:312 ../../build/app/i18n/custmsg.h:1453
#: ../../build/app/i18n/custmsg.h:2739 ../../build/app/i18n/custmsg.h:4035
#: ../../build/app/i18n/custmsg.h:5321
msgid "As before, drag on one of the Red arrows to complete the Curve.\n"
msgstr ""
"Wie schon vorher beenden Sie den Bogen, indem Sie an einer der Pfeilspitzen "
"ziehen.\n"

#. i18n: /home/martin/xtrackcad/src/gtk3/app/lib/demos/dmcrvtrk.xtr:63
#. i18n: /home/martin/xtrackcad/src/gtk3/build/app/share/xtrkcad-5.4.0/demos/dmcrvtrk.xtr:63
#. i18n: /home/martin/xtrackcad/src/gtk3/build/install/share/xtrkcad-5.4.0/demos/dmcrvtrk.xtr:63
#. i18n: /home/martin/xtrackcad/src/gtk3/build/regression-install/share/xtrkcad-5.4.0.b97b8ced2f12/demos/dmcrvtrk.xtr:63
#. i18n: /home/martin/xtrackcad/src/gtk3/build/regression-install/share/xtrkcad-5.4.0/demos/dmcrvtrk.xtr:63
#: ../../build/app/i18n/custmsg.h:314 ../../build/app/i18n/custmsg.h:1455
#: ../../build/app/i18n/custmsg.h:2741 ../../build/app/i18n/custmsg.h:4037
#: ../../build/app/i18n/custmsg.h:5323
msgid ""
"The next method is similar to the last except that you drag first from the "
"center of the Curve to one End-Point.\n"
msgstr ""
"Die nächste Methode ist vergleichbar zur vorherigen, allerdings Ziehen Sie "
"zuerst vom Mittelpunkt zu einem Endpunkt.\n"

#. i18n: /home/martin/xtrackcad/src/gtk3/app/lib/demos/dmcrvtrk.xtr:80
#. i18n: /home/martin/xtrackcad/src/gtk3/build/app/share/xtrkcad-5.4.0/demos/dmcrvtrk.xtr:80
