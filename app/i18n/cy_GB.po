msgstr "Gellir addasu Ymylon Tabl trwy lusgo ar eu pennau.\n"

#. i18n: C:/Users/mf/Documents/XTrackCAD/src/v5_3_0_beta1/app/lib/demos/dmtbledg.xtr:193
#: ../../../../build/v_5_3_0_beta1/app/i18n/custmsg.h:1079
