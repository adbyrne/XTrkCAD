#. i18n: /home/martin/xtrackcad/src/gtk3/app/lib/demos/dmmovabt.xtr:63
#: ../../build/app/i18n/custmsg.h:868
msgid ""
"You can also Right-Drag on the Map window to set the scale and position of "
"the Main window.\n"
msgstr ""
"Hiiren oikealla painikkeella raahaaminen puolestaan muuttaa näytettävän "
"alueen skaalausta (kokoa).\n"

#. i18n: /home/martin/xtrackcad/src/gtk3/app/lib/demos/dmmovabt.xtr:72
#. i18n: /home/martin/xtrackcad/src/gtk3/app/lib/demos/dmnotes.xtr:6
