<?xml version="1.0" encoding="UTF-8"?>
<interface>
    <requires lib="gtk" version="3.22" />
    <object class="GtkDialog" id="controledit">
        <property name="can-focus">False</property>
        <property name="border-width">12</property>
        <property name="type-hint">dialog</property>
        <property name="use-header-bar">0</property>
        <property name="resizable">False</property>
        <child type="action">
            <object class="GtkButton" id="id_cancel">
                <property name="use-underline">True</property>
                <property name="label">_Cancel</property>
                <property name="visible">True</property>
            </object>
        </child>
        <child type="action">
            <object class="GtkButton" id="id_help">
                <property name="use-underline">True</property>
                <property name="label">_Help</property>
                <property name="visible">True</property>
            </object>
        </child>
        <child type="action">
            <object class="GtkButton" id="id_ok">
                <property name="use-underline">True</property>
                <property name="can-default">True</property>
                <property name="label">_Done</property>
                <property name="visible">True</property>
            </object>
        </child>
        <action-widgets>
            <action-widget response="GTK_RESPONSE_CANCEL">id_cancel</action-widget>
            <action-widget response="GTK_RESPONSE_HELP">id_help</action-widget>
            <action-widget response="GTK_RESPONSE_OK" default="true">id_ok</action-widget>
        </action-widgets>

        <child internal-child="vbox">
            <object class="GtkBox">
                <child>
                    <object class="GtkGrid">
                        <property name="visible">True</property>
                        <property name="row_spacing">6</property>
                        <property name="column_spacing">12</property>
                        <child>
                            <object class="GtkLabel">
                                <property name="visible">True</property>
                                <property name="label" translatable="yes">_Name</property>
                                <property name="use_underline">True</property>
                                <property name="mnemonic_widget">name</property>
                                <property name="xalign">1</property>
                            </object>
                            <packing>
                                <property name="left_attach">0</property>
                                <property name="top_attach">0</property>
                            </packing>
                        </child>
                        <child>
                            <object class="GtkEntry" id="name">
                                <property name="visible">True</property>
                                <property name="can_focus">True</property>
                                <property name="halign">start</property>
                                <property name="max_length">80</property>
                                <property name="width_chars">20</property>
                            </object>
                            <packing>
                                <property name="left_attach">1</property>
                                <property name="top_attach">0</property>
                            </packing>
                        </child>
                        <child>
                            <object class="GtkEntry" id="origx">
                                <property name="visible">True</property>
                                <property name="can_focus">True</property>
                                <property name="halign">start</property>
                                <property name="valign">center</property>
                                <property name="hexpand">True</property>
                                <property name="width_chars">10</property>
                            </object>
                            <packing>
                                <property name="left_attach">1</property>
                                <property name="top_attach">1</property>
                            </packing>
                        </child>
                        <child>
                            <object class="GtkLabel">
                                <property name="visible">True</property>
                                <property name="can_focus">False</property>
                                <property name="valign">center</property>
                                <property name="label" translatable="yes">Orig _X</property>
                                <property name="use_underline">True</property>
                                <property name="mnemonic_widget">origx</property>
                                <property name="xalign">1</property>
                            </object>
                            <packing>
                                <property name="left_attach">0</property>
                                <property name="top_attach">1</property>
                            </packing>
                        </child>
                        <child>
                            <object class="GtkLabel">
                                <property name="visible">True</property>
                                <property name="can_focus">False</property>
                                <property name="label" translatable="yes">_On Script</property>
                                <property name="use_underline">True</property>
                                <property name="mnemonic_widget">scripton</property>
                                <property name="xalign">1</property>
                            </object>
                            <packing>
                                <property name="left_attach">0</property>
                                <property name="top_attach">3</property>
                            </packing>
                        </child>
                        <child>
                            <object class="GtkEntry" id="origy">
                                <property name="visible">True</property>
                                <property name="can_focus">True</property>
                                <property name="halign">start</property>
                                <property name="width_chars">10</property>
                            </object>
                            <packing>
                                <property name="left_attach">1</property>
                                <property name="top_attach">2</property>
                            </packing>
                        </child>
                        <child>
                            <object class="GtkEntry" id="scripton">
                                <property name="visible">True</property>
                                <property name="can_focus">True</property>
                                <property name="max_length">1024</property>
                                <property name="width_chars">40</property>
                            </object>
                            <packing>
                                <property name="left_attach">1</property>
                                <property name="top_attach">3</property>
                            </packing>
                        </child>
                        <child>
                            <object class="GtkLabel">
                                <property name="visible">True</property>
                                <property name="can_focus">False</property>
                                <property name="label" translatable="yes">Orig _Y</property>
                                <property name="use_underline">True</property>
                                <property name="mnemonic_widget">origy</property>
                                <property name="xalign">1</property>
                            </object>
                            <packing>
                                <property name="left_attach">0</property>
                                <property name="top_attach">2</property>
                            </packing>
                        </child>
                        <child>
                            <object class="GtkLabel">
                                <property name="visible">True</property>
                                <property name="can_focus">False</property>
                                <property name="label" translatable="yes">O_ff Script</property>
                                <property name="use_underline">True</property>
                                <property name="mnemonic_widget">scriptoff</property>
                            </object>
                            <packing>
                                <property name="left_attach">0</property>
                                <property name="top_attach">4</property>
                            </packing>
                        </child>
                        <child>
                            <object class="GtkEntry" id="scriptoff">
                                <property name="visible">True</property>
                                <property name="can_focus">True</property>
                                <property name="max_length">1024</property>
                                <property name="width_chars">40</property>
                                <property name="margin-bottom">12</property>
                            </object>
                            <packing>
                                <property name="left_attach">1</property>
                                <property name="top_attach">4</property>
                            </packing>
                        </child>
                    </object>
                    <packing>
                        <property name="expand">True</property>
                        <property name="fill">True</property>
                        <property name="position">1</property>
                    </packing>
                </child>
            </object>
        </child>

    </object>
</interface>