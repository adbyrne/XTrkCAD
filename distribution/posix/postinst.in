#!/bin/sh
LOGF=${HOME}/xtrkcad-setup.log
if [ -f "${LOGF}" ] ; then
	chmod 666 ${LOGF}
	echo postinst: $* >> ${LOGF}
else
	LOGF=/dev/null
fi

# Generated (configure_file) from postinst.in — INSTALLDIR always matches
# this build's actual XTRKCAD_SHARE_INSTALL_DIR, instead of a hand-maintained
# guess that had to be toggled by hand for every GA/Beta build.
INSTALLDIR=@CPACK_PACKAGING_INSTALL_PREFIX@/@XTRKCAD_SHARE_INSTALL_DIR@

( su -c "sh ${INSTALLDIR}/xtrkcad-setup install ${INSTALLDIR}" -l $SUDO_USER ) >> ${LOGF} 2>&1

exit 0
