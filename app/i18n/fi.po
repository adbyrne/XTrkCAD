"muistiinpanoa.\n"

#. i18n: C:/Users/mf/Documents/XTrackCAD/src/v5_3_0_beta1/app/lib/demos/dmnotes.xtr:37
#: ../../../../build/v_5_3_0_beta1/app/i18n/custmsg.h:871
#, fuzzy
msgid "You can also create a reference to a file or web link.\n"
