#: ../../build/app/i18n/custmsg.h:3667 ../../build/app/i18n/custmsg.h:4963
#: ../../build/app/i18n/custmsg.h:6249
msgid ""
"Right-Click on the Main window displays a menu list of commands as an "
"alternative to pressing the buttons on the tool bar or using the menu "
"accelerator keys."
msgstr ""
"Alternativ zur Werkzeugleiste oder den Menütasten kann durch Rechtsklicken "
"im Hauptfenster ein weiteres Befehlsmenü benutzt werden."

#. i18n: /home/martin/xtrackcad/src/gtk3/app/help/xtrkcad.tip:87
#. i18n: /home/martin/xtrackcad/src/gtk3/build/app/share/xtrkcad-5.4.0/xtrkcad.tip:87
#. i18n: /home/martin/xtrackcad/src/gtk3/build/install/share/xtrkcad-5.4.0/xtrkcad.tip:87
