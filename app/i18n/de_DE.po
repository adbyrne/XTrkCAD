#: ../../build/app/i18n/custmsg.h:3083 ../../build/app/i18n/custmsg.h:4379
#: ../../build/app/i18n/custmsg.h:5665
msgid ""
"Next, join the 2 straight tracks to the helix in the same way we join to a "
"circle.\n"
msgstr ""
"Als nächstes verbinden Sie die zwei geraden Gleise mit der Wendel genauso "
"wir Sie Gleise mit einem Kreis verbinden.\n"

#. i18n: /home/martin/xtrackcad/src/gtk3/app/lib/demos/dmhelix.xtr:145
#. i18n: /home/martin/xtrackcad/src/gtk3/build/app/share/xtrkcad-5.4.0/demos/dmhelix.xtr:145
