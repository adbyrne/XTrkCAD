#. i18n: C:/Users/mf/Documents/XTrackCAD/src/v5_3_0_beta1/app/lib/demos/dmctlpnl.xtr:492
#: ../../../../build/v_5_3_0_beta1/app/i18n/custmsg.h:329
#, fuzzy
msgid ""
"Notice how the Snap Grid keeps the main line and siding track parallel and "
