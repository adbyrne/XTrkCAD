#: ../../build/app/i18n/custmsg.h:2722 ../../build/app/i18n/custmsg.h:4018
#: ../../build/app/i18n/custmsg.h:5304
msgid ""
"We can use the <Connect> command to move the connecting tracks slightly and "
"connect the 2 End-Points.\n"
msgstr ""
"Mit dem <Connect>  Befehl können wir die zu verbindenden Gleise leicht "
"verschieben und die beiden Endpunkte verbinden.\n"

#. i18n: /home/martin/xtrackcad/src/gtk3/app/lib/demos/dmconn2.xtr:224
#. i18n: /home/martin/xtrackcad/src/gtk3/build/app/share/xtrkcad-5.4.0/demos/dmconn2.xtr:224
#. i18n: /home/martin/xtrackcad/src/gtk3/build/install/share/xtrkcad-5.4.0/demos/dmconn2.xtr:224
#. i18n: /home/martin/xtrackcad/src/gtk3/build/regression-install/share/xtrkcad-5.4.0.b97b8ced2f12/demos/dmconn2.xtr:224
#. i18n: /home/martin/xtrackcad/src/gtk3/build/regression-install/share/xtrkcad-5.4.0/demos/dmconn2.xtr:224
#: ../../build/app/i18n/custmsg.h:297 ../../build/app/i18n/custmsg.h:1438
#: ../../build/app/i18n/custmsg.h:2724 ../../build/app/i18n/custmsg.h:4020
#: ../../build/app/i18n/custmsg.h:5306
msgid "The two End-Points are now aligned and connected.\n"
msgstr "Die beiden Endpunkte sind jetzt ausgerichtet und verbunden.\n"

#. i18n: /home/martin/xtrackcad/src/gtk3/app/lib/demos/dmconn2.xtr:231
#. i18n: /home/martin/xtrackcad/src/gtk3/build/app/share/xtrkcad-5.4.0/demos/dmconn2.xtr:231
