#. i18n: C:/Users/mf/Documents/XTrackCAD/src/v5_3_0_beta1/app/lib/demos/dmcancel.xtr:73
#: ../../../../build/v_5_3_0_beta1/app/i18n/custmsg.h:248
msgid "and change the turnout name and part no.\n"
