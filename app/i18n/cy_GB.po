msgstr ""
"Mae'r demo hefyd yn efelychu gwerthoedd mewnbynnu a dewis opsiynau ar "
"ddeialogau amrywiol.\n"

#: ../../build/app/i18n/custmsg.h:391
msgid ""
"This is simulated by drawing a rectangle around the control when values are "
