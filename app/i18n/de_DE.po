#: ../../build/app/i18n/custmsg.h:3677 ../../build/app/i18n/custmsg.h:4973
#: ../../build/app/i18n/custmsg.h:6259
msgid ""
"The File menu contains a list of the last 5 layouts you were working on."
msgstr ""
"Der Dialog \"Datei\" enthält eine Liste der letzten 5 Gleispläne, die Sie "
"geöffnet hatten."

#. i18n: /home/martin/xtrackcad/src/gtk3/app/help/xtrkcad.tip:99
#. i18n: /home/martin/xtrackcad/src/gtk3/build/install/share/xtrkcad-5.4.0/xtrkcad.tip:99
