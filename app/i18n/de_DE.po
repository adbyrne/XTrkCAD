#: ../../build/app/i18n/custmsg.h:3085 ../../build/app/i18n/custmsg.h:4381
#: ../../build/app/i18n/custmsg.h:5667
msgid ""
"Notice that the length has increased because we have more than 4 turns in "
"the helix.  It is closer to 4.25 turns.\n"
msgstr ""
"Beachten Sie, dass sich die Länge vergrößert hat, da wir mehr als vier "
"Windungen in der Wendel haben. Es sind nahe an 4,25 Umdrehungen.\n"

#. i18n: /home/martin/xtrackcad/src/gtk3/app/lib/demos/dmhelix.xtr:155
#. i18n: /home/martin/xtrackcad/src/gtk3/build/app/share/xtrkcad-5.4.0/demos/dmhelix.xtr:155
#. i18n: /home/martin/xtrackcad/src/gtk3/build/install/share/xtrkcad-5.4.0/demos/dmhelix.xtr:155
