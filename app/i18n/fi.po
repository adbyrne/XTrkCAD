#. i18n: /home/martin/xtrackcad/src/gtk3/app/lib/demos/dmtosel.xtr:408
#. i18n: /home/martin/xtrackcad/src/gtk3/app/lib/demos/dmtotrim.xtr:21
#: ../../build/app/i18n/custmsg.h:1129
