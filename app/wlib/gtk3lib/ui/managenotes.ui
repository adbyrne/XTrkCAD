<?xml version="1.0" encoding="UTF-8"?>
<!-- Manage Notes dialog (SF #800 phase 3, SF #802 follow-on). Four tabs,
     one per note type (Text/Weblink/Document/JSON): each has a Color and
     Shape picker (SF #802 follow-on, per-type visual properties, see
     trknote.c's noteTypeProps[]/DrawNoteShape()). The JSON tab additionally
     keeps the dialog's original content: a flat registry of ROOT-level
     JSON Note field names to group/filter the Notes Report by (see
     notenames.h), plus a "Search for Names" button that scans this
     layout's JSON Notes for ROOT-level field names not yet registered.
     That part is modeled on layergroup.ui's list+buttons column, minus the
     membership shuttle (this registry has no per-entry membership, just
     names). -->
<interface>
  <requires lib="gtk+" version="3.20"/>
  <object class="GtkListStore" id="namesListStore">
    <columns>
      <column type="gboolean"/>
      <column type="gpointer"/>
      <column type="gpointer"/>
      <column type="gchararray"/>
    </columns>
  </object>
  <object class="GtkListStore" id="textshapelist">
    <columns>
      <column type="gboolean"/>
      <column type="gpointer"/>
      <column type="gpointer"/>
      <column type="gchararray"/>
    </columns>
  </object>
  <object class="GtkListStore" id="weblinkshapelist">
    <columns>
      <column type="gboolean"/>
      <column type="gpointer"/>
      <column type="gpointer"/>
      <column type="gchararray"/>
    </columns>
  </object>
  <object class="GtkListStore" id="docshapelist">
    <columns>
      <column type="gboolean"/>
      <column type="gpointer"/>
      <column type="gpointer"/>
      <column type="gchararray"/>
    </columns>
  </object>
  <object class="GtkListStore" id="jsonshapelist">
    <columns>
      <column type="gboolean"/>
      <column type="gpointer"/>
      <column type="gpointer"/>
      <column type="gchararray"/>
    </columns>
  </object>
  <object class="GtkDialog" id="managenotes">
    <property name="can_focus">False</property>
    <property name="border_width">18</property>
    <property name="type_hint">dialog</property>
    <child type="action">
      <object class="GtkButton" id="id_cancel">
        <property name="use-underline">True</property>
        <property name="label">_Cancel</property>
        <property name="visible">True</property>
      </object>
    </child>
    <child type="action">
      <object class="GtkButton" id="id_help">
        <property name="use-underline">True</property>
        <property name="label">_Help</property>
        <property name="visible">True</property>
      </object>
    </child>
    <child type="action">
      <object class="GtkButton" id="id_ok">
        <property name="use-underline">True</property>
        <property name="can-default">True</property>
        <property name="label">_Done</property>
        <property name="visible">True</property>
      </object>
    </child>
    <action-widgets>
      <action-widget response="GTK_RESPONSE_CANCEL">id_cancel</action-widget>
      <action-widget response="GTK_RESPONSE_HELP">id_help</action-widget>
      <action-widget response="GTK_RESPONSE_OK" default="true">id_ok</action-widget>
    </action-widgets>

    <child internal-child="vbox">
      <object class="GtkBox">
        <property name="hexpand">True</property>
        <property name="vexpand">True</property>
        <property name="orientation">vertical</property>
        <property name="spacing">18</property>
        <child>
          <object class="GtkNotebook">
            <property name="can-focus">False</property>
            <property name="visible">True</property>

            <!-- Text tab -->
            <child>
              <object class="GtkGrid" id="texttab">
                <property name="can-focus">False</property>
                <property name="column-spacing">12</property>
                <property name="row-spacing">6</property>
                <property name="margin-top">6</property>
                <property name="margin-bottom">6</property>
                <property name="margin-start">6</property>
                <property name="margin-end">6</property>
                <property name="visible">True</property>
                <child>
                  <object class="GtkLabel">
                    <property name="visible">True</property>
                    <property name="halign">end</property>
                    <property name="label" translatable="yes">Color</property>
                  </object>
                  <packing>
                    <property name="left-attach">0</property>
                    <property name="top-attach">0</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkColorButton" id="textcolor">
                    <property name="can-focus">True</property>
                    <property name="halign">start</property>
                    <property name="receives-default">True</property>
                    <property name="visible">True</property>
                  </object>
                  <packing>
                    <property name="left-attach">1</property>
                    <property name="top-attach">0</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="visible">True</property>
                    <property name="halign">end</property>
                    <property name="label" translatable="yes">Shape</property>
                  </object>
                  <packing>
                    <property name="left-attach">0</property>
                    <property name="top-attach">1</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkComboBox" id="textshape">
                    <property name="model">textshapelist</property>
                    <property name="visible">True</property>
                    <property name="can_focus">False</property>
                    <child>
                      <object class="GtkCellRendererText" id="textshapetextfield">
                        <property name="width-chars">10</property>
                      </object>
                      <attributes>
                        <attribute name="text">3</attribute>
                      </attributes>
                    </child>
                  </object>
                  <packing>
                    <property name="left-attach">1</property>
                    <property name="top-attach">1</property>
                  </packing>
                </child>
              </object>
            </child>
            <child type="tab">
              <object class="GtkLabel">
                <property name="can-focus">False</property>
                <property name="label" translatable="yes">Text</property>
                <property name="margin-left">6</property>
                <property name="margin-right">6</property>
                <property name="visible">True</property>
              </object>
              <packing>
                <property name="tab-fill">False</property>
              </packing>
            </child>

            <!-- Weblink tab -->
            <child>
              <object class="GtkGrid" id="weblinktab">
                <property name="can-focus">False</property>
                <property name="column-spacing">12</property>
                <property name="row-spacing">6</property>
                <property name="margin-top">6</property>
                <property name="margin-bottom">6</property>
                <property name="margin-start">6</property>
                <property name="margin-end">6</property>
                <property name="visible">True</property>
                <child>
                  <object class="GtkLabel">
                    <property name="visible">True</property>
                    <property name="halign">end</property>
                    <property name="label" translatable="yes">Color</property>
                  </object>
                  <packing>
                    <property name="left-attach">0</property>
                    <property name="top-attach">0</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkColorButton" id="weblinkcolor">
                    <property name="can-focus">True</property>
                    <property name="halign">start</property>
                    <property name="receives-default">True</property>
                    <property name="visible">True</property>
                  </object>
                  <packing>
                    <property name="left-attach">1</property>
                    <property name="top-attach">0</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="visible">True</property>
                    <property name="halign">end</property>
                    <property name="label" translatable="yes">Shape</property>
                  </object>
                  <packing>
                    <property name="left-attach">0</property>
                    <property name="top-attach">1</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkComboBox" id="weblinkshape">
                    <property name="model">weblinkshapelist</property>
                    <property name="visible">True</property>
                    <property name="can_focus">False</property>
                    <child>
                      <object class="GtkCellRendererText" id="weblinkshapetextfield">
                        <property name="width-chars">10</property>
                      </object>
                      <attributes>
                        <attribute name="text">3</attribute>
                      </attributes>
                    </child>
                  </object>
                  <packing>
                    <property name="left-attach">1</property>
                    <property name="top-attach">1</property>
                  </packing>
                </child>
              </object>
            </child>
            <child type="tab">
              <object class="GtkLabel">
                <property name="can-focus">False</property>
                <property name="label" translatable="yes">Weblink</property>
                <property name="margin-left">6</property>
                <property name="margin-right">6</property>
                <property name="visible">True</property>
              </object>
              <packing>
                <property name="position">1</property>
                <property name="tab-fill">False</property>
              </packing>
            </child>

            <!-- Document tab -->
            <child>
              <object class="GtkGrid" id="doctab">
                <property name="can-focus">False</property>
                <property name="column-spacing">12</property>
                <property name="row-spacing">6</property>
                <property name="margin-top">6</property>
                <property name="margin-bottom">6</property>
                <property name="margin-start">6</property>
                <property name="margin-end">6</property>
                <property name="visible">True</property>
                <child>
                  <object class="GtkLabel">
                    <property name="visible">True</property>
                    <property name="halign">end</property>
                    <property name="label" translatable="yes">Color</property>
                  </object>
                  <packing>
                    <property name="left-attach">0</property>
                    <property name="top-attach">0</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkColorButton" id="doccolor">
                    <property name="can-focus">True</property>
                    <property name="halign">start</property>
                    <property name="receives-default">True</property>
                    <property name="visible">True</property>
                  </object>
                  <packing>
                    <property name="left-attach">1</property>
                    <property name="top-attach">0</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="visible">True</property>
                    <property name="halign">end</property>
                    <property name="label" translatable="yes">Shape</property>
                  </object>
                  <packing>
                    <property name="left-attach">0</property>
                    <property name="top-attach">1</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkComboBox" id="docshape">
                    <property name="model">docshapelist</property>
                    <property name="visible">True</property>
                    <property name="can_focus">False</property>
                    <child>
                      <object class="GtkCellRendererText" id="docshapetextfield">
                        <property name="width-chars">10</property>
                      </object>
                      <attributes>
                        <attribute name="text">3</attribute>
                      </attributes>
                    </child>
                  </object>
                  <packing>
                    <property name="left-attach">1</property>
                    <property name="top-attach">1</property>
                  </packing>
                </child>
              </object>
            </child>
            <child type="tab">
              <object class="GtkLabel">
                <property name="can-focus">False</property>
                <property name="label" translatable="yes">Document</property>
                <property name="margin-left">6</property>
                <property name="margin-right">6</property>
                <property name="visible">True</property>
              </object>
              <packing>
                <property name="position">2</property>
                <property name="tab-fill">False</property>
              </packing>
            </child>

            <!-- JSON tab: Color/Shape plus the original ROOT Names content -->
            <child>
              <object class="GtkBox" id="jsontab">
                <property name="can-focus">False</property>
                <property name="orientation">vertical</property>
                <property name="spacing">12</property>
                <property name="margin-top">6</property>
                <property name="margin-bottom">6</property>
                <property name="margin-start">6</property>
                <property name="margin-end">6</property>
                <property name="visible">True</property>
                <child>
                  <object class="GtkGrid">
                    <property name="can-focus">False</property>
                    <property name="column-spacing">12</property>
                    <property name="row-spacing">6</property>
                    <property name="visible">True</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="halign">end</property>
                        <property name="label" translatable="yes">Color</property>
                      </object>
                      <packing>
                        <property name="left-attach">0</property>
                        <property name="top-attach">0</property>
                      </packing>
                    </child>
                    <child>
                      <object class="GtkColorButton" id="jsoncolor">
                        <property name="can-focus">True</property>
                        <property name="halign">start</property>
                        <property name="receives-default">True</property>
                        <property name="visible">True</property>
                      </object>
                      <packing>
                        <property name="left-attach">1</property>
                        <property name="top-attach">0</property>
                      </packing>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="halign">end</property>
                        <property name="label" translatable="yes">Shape</property>
                      </object>
                      <packing>
                        <property name="left-attach">0</property>
                        <property name="top-attach">1</property>
                      </packing>
                    </child>
                    <child>
                      <object class="GtkComboBox" id="jsonshape">
                        <property name="model">jsonshapelist</property>
                        <property name="visible">True</property>
                        <property name="can_focus">False</property>
                        <child>
                          <object class="GtkCellRendererText" id="jsonshapetextfield">
                            <property name="width-chars">10</property>
                          </object>
                          <attributes>
                            <attribute name="text">3</attribute>
                          </attributes>
                        </child>
                      </object>
                      <packing>
                        <property name="left-attach">1</property>
                        <property name="top-attach">1</property>
                      </packing>
                    </child>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">True</property>
                    <property name="position">0</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="visible">True</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="halign">start</property>
                        <property name="label" translatable="yes">Registered ROOT Names</property>
                      </object>
                      <packing>
                        <property name="expand">False</property>
                        <property name="position">0</property>
                      </packing>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="visible">True</property>
                        <property name="can_focus">False</property>
                        <property name="spacing">12</property>
                        <child>
                          <object class="GtkScrolledWindow" id="names">
                            <property name="visible">True</property>
                            <property name="can_focus">True</property>
                            <property name="hexpand">True</property>
                            <property name="vexpand">True</property>
                            <property name="shadow_type">in</property>
                            <property name="min_content_width">220</property>
                            <property name="min_content_height">200</property>
                            <child>
                              <object class="GtkTreeView" id="namesTreeView">
                                <property name="visible">True</property>
                                <property name="can_focus">True</property>
                                <property name="hexpand">True</property>
                                <property name="vexpand">True</property>
                                <property name="model">namesListStore</property>
                                <property name="headers-visible">False</property>
                                <child internal-child="selection">
                                  <object class="GtkTreeSelection" id="namesSelection"/>
                                </child>
                                <child>
                                  <object class="GtkTreeViewColumn" id="namesCol">
                                    <property name="sizing">autosize</property>
                                    <property name="min_width">200</property>
                                    <child>
                                      <object class="GtkCellRendererText"/>
                                      <attributes>
                                        <attribute name="text">3</attribute>
                                      </attributes>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                          <packing>
                            <property name="expand">True</property>
                            <property name="fill">True</property>
                            <property name="position">0</property>
                          </packing>
                        </child>
                        <child>
                          <object class="GtkButtonBox">
                            <property name="visible">True</property>
                            <property name="can_focus">False</property>
                            <property name="orientation">vertical</property>
                            <property name="spacing">6</property>
                            <property name="layout_style">start</property>
                            <child>
                              <object class="GtkButton" id="new">
                                <property name="label" translatable="yes">Add...</property>
                                <property name="visible">True</property>
                                <property name="can_focus">True</property>
                                <property name="receives_default">True</property>
                              </object>
                              <packing>
                                <property name="expand">True</property>
                                <property name="fill">True</property>
                                <property name="position">0</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkButton" id="delete">
                                <property name="label" translatable="yes">Delete</property>
                                <property name="visible">True</property>
                                <property name="can_focus">True</property>
                                <property name="receives_default">True</property>
                              </object>
                              <packing>
                                <property name="expand">True</property>
                                <property name="fill">True</property>
                                <property name="position">1</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkButton" id="search">
                                <property name="label" translatable="yes">Search for Names</property>
                                <property name="tooltip-text" translatable="yes">Scan this layout's JSON Notes for ROOT-level field names not yet registered, and add them</property>
                                <property name="visible">True</property>
                                <property name="can_focus">True</property>
                                <property name="receives_default">True</property>
                              </object>
                              <packing>
                                <property name="expand">True</property>
                                <property name="fill">True</property>
                                <property name="position">2</property>
                              </packing>
                            </child>
                          </object>
                          <packing>
                            <property name="expand">False</property>
                            <property name="fill">True</property>
                            <property name="position">1</property>
                          </packing>
                        </child>
                      </object>
                      <packing>
                        <property name="expand">True</property>
                        <property name="fill">True</property>
                        <property name="position">1</property>
                      </packing>
                    </child>
                  </object>
                  <packing>
                    <property name="expand">True</property>
                    <property name="fill">True</property>
                    <property name="position">1</property>
                  </packing>
                </child>
              </object>
            </child>
            <child type="tab">
              <object class="GtkLabel">
                <property name="can-focus">False</property>
                <property name="label" translatable="yes">JSON</property>
                <property name="margin-left">6</property>
                <property name="margin-right">6</property>
                <property name="visible">True</property>
              </object>
              <packing>
                <property name="position">3</property>
                <property name="tab-fill">False</property>
              </packing>
            </child>
          </object>
          <packing>
            <property name="expand">True</property>
            <property name="fill">True</property>
            <property name="position">0</property>
          </packing>
        </child>
      </object>
    </child>
  </object>
</interface>
