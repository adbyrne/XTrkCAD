#. i18n: /home/martin/xtrackcad/src/gtk3/build/regression-install/share/xtrkcad-5.4.0/demos/dmcrvtrk.xtr:80
#: ../../build/app/i18n/custmsg.h:316 ../../build/app/i18n/custmsg.h:1457
#: ../../build/app/i18n/custmsg.h:2743 ../../build/app/i18n/custmsg.h:4039
#: ../../build/app/i18n/custmsg.h:5325
msgid "Once again, drag on a Red arrow to complete the Curve.\n"
msgstr ""
"Auch diesmal ziehen Sie an der roten Pfeilspitze um den Bogen zu vollenden.\n"

#. i18n: /home/martin/xtrackcad/src/gtk3/app/lib/demos/dmcrvtrk.xtr:90
#. i18n: /home/martin/xtrackcad/src/gtk3/build/app/share/xtrkcad-5.4.0/demos/dmcrvtrk.xtr:90
#. i18n: /home/martin/xtrackcad/src/gtk3/build/install/share/xtrkcad-5.4.0/demos/dmcrvtrk.xtr:90
#. i18n: /home/martin/xtrackcad/src/gtk3/build/regression-install/share/xtrkcad-5.4.0.b97b8ced2f12/demos/dmcrvtrk.xtr:90
#. i18n: /home/martin/xtrackcad/src/gtk3/build/regression-install/share/xtrkcad-5.4.0/demos/dmcrvtrk.xtr:90
#: ../../build/app/i18n/custmsg.h:318 ../../build/app/i18n/custmsg.h:1459
#: ../../build/app/i18n/custmsg.h:2745 ../../build/app/i18n/custmsg.h:4041
#: ../../build/app/i18n/custmsg.h:5327
msgid ""
"The last method begins by drawing a line between the two End-Points of the "
"Curve.  This forms the Chord of the Curve.\n"
msgstr ""
"Bei der letzten Methode beginnen Sie, indem Sie eine Linie zwischen den "
"beiden Endpunkten ziehen. Diese bildet die Sehne des Bogen.\n"

#. i18n: /home/martin/xtrackcad/src/gtk3/app/lib/demos/dmcrvtrk.xtr:108
#. i18n: /home/martin/xtrackcad/src/gtk3/build/app/share/xtrkcad-5.4.0/demos/dmcrvtrk.xtr:108
#. i18n: /home/martin/xtrackcad/src/gtk3/build/install/share/xtrkcad-5.4.0/demos/dmcrvtrk.xtr:108
