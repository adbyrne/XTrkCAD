<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="3.20" />
  <object class="GtkWindow" id="main">
    <property name="can-focus">False</property>
    <child>
      <object class="GtkBox" id="windowgrid">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="hexpand">True</property>
        <property name="vexpand">True</property>
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkMenuBar" id="menubar">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="hexpand">True</property>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
            <property name="position">0</property>
          </packing>
        </child>
        <child>
          <object class="GtkBox" id="toolbarWindow">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="halign">GTK_ALIGN_START</property>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
            <property name="position">1</property>
          </packing>
        </child>
        <child>
          <object class="GtkSeparator">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
            <property name="position">2</property>
          </packing>
        </child>
        <child>
          <object class="GtkBox" id="hotbar">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="spacing">3</property>
            <child>
              <object class="GtkButton" id="hotBarLeft">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="receives-default">True</property>
                <property name="double-buffered">False</property>
                <property name="use-underline">True</property>
                <property name="always-show-image">True</property>
                <child>
                  <object class="GtkImage">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="double-buffered">False</property>
                    <property name="stock">gtk-media-rewind</property>
                  </object>
                </child>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkDrawingArea" id="hotBarDraw">
                <property name="height-request">30</property>
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="hexpand">True</property>
              </object>
              <packing>
                <property name="expand">True</property>
                <property name="fill">True</property>
                <property name="position">1</property>
              </packing>
            </child>
            <child>
              <object class="GtkButton" id="hotBarRight">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="receives-default">True</property>
                <child>
                  <object class="GtkImage">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="double-buffered">False</property>
                    <property name="stock">gtk-media-forward</property>
                  </object>
                </child>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">2</property>
              </packing>
            </child>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
            <property name="position">3</property>
          </packing>
        </child>
        <child>
          <object class="GtkSeparator">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
            <property name="position">4</property>
          </packing>
        </child>
        <child>
          <object class="GtkDrawingArea" id="maindraw">
            <property name="width-request">500</property>
            <property name="height-request">500</property>
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="hexpand">True</property>
            <property name="vexpand">True</property>
          </object>
          <packing>
            <property name="expand">True</property>
            <property name="fill">True</property>
            <property name="position">5</property>
          </packing>
        </child>
        <child>
          <object class="GtkBox" id="statusbar">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="hexpand">True</property>
            <property name="spacing">6</property>
            <child>
              <object class="GtkLabel" id="infoBarScale">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="single-line-mode">True</property>
                <style>
                  <class name="statusbar" />
                </style>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkLabel" id="infoBarPosX">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <style>
                  <class name="statusbar" />
                </style>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">1</property>
              </packing>
            </child>
            <child>
              <object class="GtkLabel" id="infoBarPosY">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <style>
                  <class name="statusbar" />
                </style>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">2</property>
              </packing>
            </child>
            <child>
              <!--start of stack-->
              <object class="GtkStack" id="stack">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="transition-type">GTK_STACK_TRANSITION_TYPE_CROSSFADE</property>
                <!-- child status message -->
                <child>
                  <object class="GtkLabel" id="infoBarStatus">
                    <property name="visible">True</property>
                    <property name="xalign">0</property>
                  </object>
                  <packing>
                    <property name="name">message</property>
                  </packing>
                </child>
                <!-- child turntable-->
                <child>
                  <object class="GtkBox">
                    <property name="visible">True</property>
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="label" translatable="yes">Diameter:</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="diameter">
                        <property name="visible">True</property>
                        <property name="can-focus">True</property>
                        <property name="width-chars">6</property>
                      </object>
                    </child>
                  </object>
                  <packing>
                    <property name="name">turntable</property>
                  </packing>
                </child>
                <!-- child text -->
                <child>
                  <object class="GtkBox">
                    <property name="visible">True</property>
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="label" translatable="yes">Font size:</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkComboBox" id="fontsize">
                        <property name="visible">True</property>
                        <property name="can_focus">True</property>
                        <property name="model">fontsizeList</property>
                        <child>
                          <object class="GtkCellRendererText">
                            <property name="width-chars">5</property>
                          </object>
                          <attributes>
                            <attribute name="text">3</attribute>
                          </attributes>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="label" translatable="yes">Text color:</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkColorButton" id="color">
                        <property name="visible">True</property>
                        <property name="can_focus">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="label" translatable="yes">Boxed:</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="boxed">
                        <child>
                          <object class="GtkCheckButton">
                            <property name="visible">True</property>
                            <property name="can_focus">True</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                  <packing>
                    <property name="name">text</property>
                  </packing>
                </child>
                <!-- child parallel track -->
                <child>
                  <object class="GtkBox">
                    <property name="visible">True</property>
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="label" translatable="yes">Separation:</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="separation">
                        <property name="visible">True</property>
                        <property name="can_focus">True</property>
                        <property name="width_chars">6</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="label" translatable="yes">Radius factor:</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="factor">
                        <property name="visible">True</property>
                        <property name="can_focus">True</property>
                        <property name="width_chars">6</property>
                      </object>
                    </child>
                  </object>
                  <packing>
                    <property name="name">parallel</property>
                  </packing>
                </child>
                <!-- child parallel line -->
                <child>
                  <object class="GtkBox">
                    <property name="visible">True</property>
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="label" translatable="yes">Separation:</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="lineseparation">
                        <property name="visible">True</property>
                        <property name="can_focus">True</property>
                        <property name="width_chars">6</property>
                      </object>
                    </child>
                  </object>
                  <packing>
                    <property name="name">parallelLine</property>
                  </packing>
                </child>
                <!-- join -->
                <child>
                  <object class="GtkBox">
                    <property name="visible">True</property>
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="label" translatable="yes">Desired radius:</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="radius">
                        <property name="visible">True</property>
                        <property name="can_focus">True</property>
                        <property name="width_chars">6</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="label" translatable="yes">Select 2nd track</property>
                      </object>
                    </child>
                  </object>
                  <packing>
                    <property name="name">joinfixed</property>
                  </packing>
                </child>
                <!-- cornu -->
                <child>
                  <object class="GtkBox">
                    <property name="visible">True</property>
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="label" translatable="yes">End Angle:</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="endangle">
                        <property name="visible">True</property>
                        <property name="can_focus">True</property>
                        <property name="width_chars">6</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="label" translatable="yes">End Radius:</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="endradius">
                        <property name="visible">True</property>
                        <property name="can_focus">True</property>
                        <property name="width_chars">6</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="label" translatable="yes">Pick on point to adjust it along track - Delete to remove, Enter to confirm, ESC to abort</property>
                      </object>
                    </child>

                  </object>
                  <packing>
                    <property name="name">cornuMod</property>
                  </packing>
                </child>
                <!-- circle -->
                <child>
                  <object class="GtkBox">
                    <property name="visible">True</property>
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="label" translatable="yes">Circle Radius:</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="circleradius">
                        <property name="visible">True</property>
                        <property name="can_focus">True</property>
                        <property name="width_chars">6</property>
                      </object>
                    </child>
                  </object>
                  <packing>
                    <property name="name">circle</property>
                  </packing>
                </child>
                <!-- fixed radius curve -->
                <child>
                  <object class="GtkBox">
                    <property name="visible">True</property>
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="visible">True</property>
                        <property name="label" translatable="yes">Desired Radius:</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="fixedradius">
                        <property name="visible">True</property>
                        <property name="can_focus">True</property>
                        <property name="width_chars">6</property>
                      </object>
                    </child>
                  </object>
                  <packing>
                    <property name="name">curvefixed</property>
                  </packing>
                </child>
                <!-- next child -->
                <child>
                  <object class="GtkBox">
                    <property name="visible">True</property>
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkLabel">
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry">
                        <property name="visible">True</property>
                        <property name="can_focus">True</property>
                        <property name="width_chars">6</property>
                      </object>
                    </child>
                  </object>
                  <packing>
                    <property name="name">parametergroup</property>
                  </packing>
                </child>
              </object>
              <packing>
                <property name="expand">True</property>
                <property name="fill">True</property>
                <property name="position">3</property>
              </packing>
              <!-- end of stack -->
            </child>
            <style>
              <class name="statusbar" />
            </style>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
            <property name="position">6</property>
          </packing>
        </child>
      </object>
    </child>
  </object>
  <object class="GtkComboBox" id="cmdLayerSet">
    <property name="model">layerList</property>
    <property name="visible">True</property>
    <style>
      <class name="toolbar" />
    </style>
    <child>
      <object class="GtkCellRendererText" id="textfield">
        <property name="width-chars">20</property>
      </object>
      <attributes>
        <attribute name="text">3</attribute>
      </attributes>
    </child>
  </object>
  <object class="GtkListStore" id="layerList">
    <columns>
      <column type="gboolean" />
      <column type="gpointer" />
      <column type="gpointer" />
      <column type="gchararray" />
    </columns>
  </object>
  <object class="GtkListStore" id="fontsizeList">
    <columns>
      <column type="gboolean" />
      <column type="gpointer" />
      <column type="gpointer" />
      <column type="gchararray" />
    </columns>
  </object>
</interface>