"voies.\n"
"\n"

#. i18n: C:/Users/mf/Documents/XTrackCAD/src/v5_3_0_beta1/app/lib/demos/dmselect.xtr:302
#: ../../../../build/v_5_3_0_beta1/app/i18n/custmsg.h:1029
msgid "The <esc> key will deselect all objects.\n"
