VERSION 13 5.4.0
TITLE1 Layer Groups Test Layout
SCALE HO
ROOMSIZE 200 x 100

LAYERS 0 1 0 0 0 0 0 0 0 "NYE-Main"
LAYERS 1 1 0 0 0 0 0 0 0 "NYE-Siding"
LAYERS 2 1 0 0 0 0 0 0 0 "NYE-Yard"
LAYERS 3 1 0 0 0 0 0 0 0 "CO-Main"
LAYERS 4 1 0 0 0 0 0 0 0 "CO-Fiddle"
LAYERS CURRENT 0
LAYERGROUP DEFINE 0 "Mainline"
LAYERGROUP MEMBERS 0 "1;4"
LAYERGROUP DEFINE 1 "Passing"
LAYERGROUP MEMBERS 1 "2"
LAYERGROUP DEFINE 2 "Storage"
LAYERGROUP MEMBERS 2 "3"
LAYERGROUP DEFINE 3 "Staging"
LAYERGROUP MEMBERS 3 "5"
LAYERGROUP DEFINE 4 "NYE"
LAYERGROUP MEMBERS 4 "1;2;3"
LAYERGROUP DEFINE 5 "C&O"
LAYERGROUP MEMBERS 5 "4;5"

NOTE 50 0 0 0 0.000000 2.000000 0 3 "{""kind"": ""station"", ""id"": ""NA""}"
NOTE 51 0 0 0 96.000000 2.000000 0 3 "{""kind"": ""station"", ""id"": ""NB""}"
NOTE 52 3 0 0 0.000000 52.000000 0 3 "{""kind"": ""station"", ""id"": ""CA""}"
NOTE 53 3 0 0 48.000000 52.000000 0 3 "{""kind"": ""station"", ""id"": ""CB""}"

STRAIGHT 1 0 0 0 0 HO 0
	E 0.000000 0.000000 0.000000
	T 2 24.000000 0.000000 180.000000
	END$SEGS

STRAIGHT 2 0 0 0 0 HO 0
	T 1 24.000000 0.000000 0.000000
	T 3 48.000000 0.000000 180.000000
	END$SEGS

STRAIGHT 3 0 0 0 0 HO 0
	T 2 48.000000 0.000000 0.000000
	T 4 72.000000 0.000000 180.000000
	END$SEGS

STRAIGHT 4 0 0 0 0 HO 0
	T 3 72.000000 0.000000 0.000000
	E 96.000000 0.000000 180.000000
	END$SEGS

STRAIGHT 5 1 0 0 0 HO 0
	E 24.000000 10.000000 0.000000
	T 6 48.000000 10.000000 180.000000
	END$SEGS

STRAIGHT 6 1 0 0 0 HO 0
	T 5 48.000000 10.000000 0.000000
	E 72.000000 10.000000 180.000000
	END$SEGS

STRAIGHT 7 2 0 0 0 HO 0
	E 0.000000 20.000000 0.000000
	E 24.000000 20.000000 180.000000
	END$SEGS

STRAIGHT 8 3 0 0 0 HO 0
	E 0.000000 50.000000 0.000000
	T 9 24.000000 50.000000 180.000000
	END$SEGS

STRAIGHT 9 3 0 0 0 HO 0
	T 8 24.000000 50.000000 0.000000
	E 48.000000 50.000000 180.000000
	END$SEGS

STRAIGHT 10 4 0 0 0 HO 0
	E 0.000000 70.000000 0.000000
	E 36.000000 70.000000 180.000000
	END$SEGS

