id: @FLATPAK_DOMAIN@.@FLATPAK_BASE_NAME@
runtime: org.freedesktop.Platform
runtime-version: '26.08'
sdk: org.freedesktop.Sdk
command: run-xtrkcad.sh

finish-args:
  - --socket=wayland
  - --socket=fallback-x11
  - --socket=x11
  - --socket=cups
  - --socket=pulseaudio
  - --share=ipc
  - --device=dri
  - --filesystem=home
  - --env=XTRKCAD_APP_ID=@FLATPAK_DOMAIN@.@FLATPAK_BASE_NAME@

modules:
  - name: libzip
    buildsystem: cmake-ninja
    config-opts:
      - -DBUILD_DOC=OFF
      - -DBUILD_EXAMPLES=OFF
      - -DBUILD_REGRESS=OFF
      - -DBUILD_TOOLS=OFF
      - -DBUILD_OSSFUZZ=OFF
      - -DBUILD_SHARED_LIBS=OFF
      - -DENABLE_COMMONCRYPTO=OFF
      - -DENABLE_GNUTLS=OFF
      - -DENABLE_MBEDTLS=OFF
      - -DENABLE_OPENSSL=OFF
      - -DENABLE_WINDOWS_CRYPTO=OFF
      - -DENABLE_BZIP2=OFF
      - -DENABLE_LZMA=OFF
      - -DENABLE_ZSTD=OFF
      - -DCMAKE_POLICY_VERSION_MINIMUM=3.5
    sources:
      - type: archive
        url: https://github.com/nih-at/libzip/releases/download/v1.11.4/libzip-1.11.4.tar.gz
        sha256: 82e9f2f2421f9d7c2466bbc3173cd09595a88ea37db0d559a9d0a2dc60dc722e
    cleanup:
      - '*'

  - name: mxml
    buildsystem: autotools
    config-opts:
      - --prefix=/app
    sources:
      - type: archive
        url: https://github.com/michaelrsweet/mxml/releases/download/v3.3.1/mxml-3.3.1.tar.gz
        sha256: 0c663ed1fe393b5619f80101798202eea43534abd7c8aff389022fd8c1dacc32
    cleanup:
      - '*'

  - name: fake-inkscape
    buildsystem: simple
    sources:
      - type: script
        dest-filename: inkscape
        commands:
          - |
            rsvg-convert "$@"
    build-commands:
      - install -Dm755 inkscape /app/bin/inkscape
    cleanup:
      - '*'

  - name: mercurial
    # needed due to versioning (hg not part of flatpak builder sandbox)
    buildsystem: simple
    only-arches:
      - x86_64
    sources:
      - type: file
        url: https://files.pythonhosted.org/packages/e1/21/fe7e9230f0e8b43e2c897d38067ea8c6baf1dd54f10775784b019dcf59de/mercurial-7.2.4-cp314-cp314-manylinux_2_17_x86_64.manylinux2014_x86_64.manylinux_2_28_x86_64.whl
        sha256: d7e8c8028a5d74de926e26b5d073786f3e3178fcc56f5cd075e0da11c014bf2a
    build-commands:
      - pip3 install --no-index --find-links=file://$PWD --prefix=/app mercurial
    cleanup:
      - '*'

  - name: xtrkcad
    buildsystem: cmake-ninja
    sources:
      - type: dir
        path: @CMAKE_SOURCE_DIR@
    config-opts:
      - -DXTRKCAD_BUILD_FLATPAK=1
      - -DXTRKCAD_FLATPAK_NOVERSION=@XTRKCAD_FLATPAK_NOVERSION@
      - -DXTRKCAD_APPEND_SRC_HASH=@XTRKCAD_APPEND_SRC_HASH@
    builddir: true
    post-install:
      - |
        true
