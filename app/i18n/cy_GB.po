#. i18n: C:/Users/mf/Documents/XTrackCAD/src/v5_3_0_beta1/app/lib/demos/dmhndld.xtr:29
#: ../../../../build/v_5_3_0_beta1/app/i18n/custmsg.h:668
msgid ""
"    Hint: the further you drag from the frog, the more accurate the angle.\n"
