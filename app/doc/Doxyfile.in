# Doxyfile for the real, installed end-user User Guide -- built from the
# .dox/.dox.in files in this directory (converted from the former vendored
# Halibut sources by tools/but-to-doxygen.py; see
# .claude/halibut-doxygen-investigation-plan.md for the conversion history).
# messages.dox (app/help/genmessages.c's Doxygen-syntax output, one of
# INPUT's directories below) is regenerated on every build; everything else
# here is committed, hand-reviewed source, not regenerated.

PROJECT_NAME           = "XTrkCAD User Guide"
PROJECT_NUMBER         = "Version @XTRKCAD_VERSION@"
PROJECT_ICON           = "@CMAKE_CURRENT_SOURCE_DIR@/images/xtrkcad_logo.gif"
WARN_LOGFILE           = ./doxygen.log
OUTPUT_DIRECTORY       = "@CMAKE_CURRENT_BINARY_DIR@"
INPUT                  = "@CMAKE_CURRENT_SOURCE_DIR@" \
                          "@CMAKE_CURRENT_BINARY_DIR@" \
                          "@messagefile_BINARY_DIR@"
FILE_PATTERNS          = *.dox
IMAGE_PATH             = "@CMAKE_CURRENT_SOURCE_DIR@/images"
RECURSIVE              = NO

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO

# Doxygen's default for this is platform-dependent (case-sensitive on Linux,
# case-insensitive on Windows/macOS), so unpinned it silently generates
# lowercased page filenames (cmdblock.html) on Windows/macOS while keeping
# case-preserved ones (cmdBlock.html) on Linux -- discovered when SF #729/
# #730's app/doc/check_help_links.py (which does exact-case matching, since
# wHelp()'s runtime topic lookup is exact-case too) passed on every Linux CI
# job but failed release.yml's package-windows/package-macos with literally
# every non-"index" topic reported missing. Pinned explicitly so the User
# Guide's actual shipped filenames -- and what wHelp() can find at runtime --
# don't silently depend on which platform happened to package the release.
CASE_SENSE_NAMES        = YES
# Native left-sidebar navigation tree built from the \page/\subpage
# hierarchy, replacing halibut's own "Contents"/"Index" breadcrumb links --
# see DoxygenLayout.xml.
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
LAYOUT_FILE            = "@CMAKE_CURRENT_SOURCE_DIR@/DoxygenLayout.xml"
SEARCHENGINE           = NO
SOURCE_BROWSER         = NO
SHOW_FILES             = NO
SHOW_NAMESPACES        = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_AS_ERROR          = NO
MARKDOWN_SUPPORT       = YES
HTML_EXTRA_STYLESHEET  = "@CMAKE_CURRENT_SOURCE_DIR@/style.css"
