#. i18n: C:/Users/mf/Documents/XTrackCAD/src/v5_3_0_beta1/app/lib/demos/dmhndld.xtr:23
#: ../../../../build/v_5_3_0_beta1/app/i18n/custmsg.h:666
msgid "1 - click on the frog and drag away to set the frog angle\n"
