#. i18n: C:/Users/mf/Documents/XTrackCAD/src/work/app/lib/demos/dmctlpnl.xtr:112
#: ../../../../build/work/app/i18n/custmsg.h:316
msgid "This demo will construct a control panel for part of a bigger layout.\n"
