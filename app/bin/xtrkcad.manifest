<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Application manifest for Windows (Development Issues #92).

  activeCodePage UTF-8 makes UTF-8 the process code page (CP_ACP) on
  Windows 10 version 1903 and later: argv, fopen() and the other ANSI file
  functions take UTF-8 names, so a file name with characters outside the
  old code page (cp1252) can be opened, and names reach GTK as UTF-8.
  Older Windows ignores it and keeps the system code page.

  MinGW embeds it through xtrkcad-manifest.rc, which replaces the
  toolchain's default manifest, so trustInfo and supportedOS repeat what
  that one declares. MSVC's linker merges it into its own.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <!-- Windows 8 -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
      <!-- Windows 7 -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
