#: ../../build/app/i18n/custmsg.h:488
msgid " \n"
msgstr " \n"

#. i18n: /home/martin/xtrackcad/src/gtk3/app/lib/demos/dmexcept.xtr:39
#: ../../build/app/i18n/custmsg.h:490
#, fuzzy
msgid ""
"The Layout dialog shows the Minimum Track Radius is 9 inches and the Maximum "
