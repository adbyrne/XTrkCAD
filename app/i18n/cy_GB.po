#. i18n: C:/Users/mf/Documents/XTrackCAD/src/v5_3_0_beta1/app/lib/demos/dmgroup.xtr:464
#: ../../../../build/v_5_3_0_beta1/app/i18n/custmsg.h:598
#, fuzzy
msgid "We want the curve to have a radius of 20\" and an angle of 17.5Â°.\n"
